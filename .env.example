# Solo del lado del servidor (Vercel → Settings → Environment Variables). Nunca con prefijo VITE_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Web Gómez Perforaciones <web@tudominio.com>"
CONTACT_FROM_EMAIL=
# Opcional: origen permitido para el formulario, p. ej. https://gomezperforaciones.com.uy
ALLOWED_ORIGIN=
